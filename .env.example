# Read by Prisma (via prisma.config.ts) for migrations, and by the app at runtime.
# Copy this file to ".env" and fill in your local PostgreSQL connection string.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/teacher_app"

# Optional isolated database used by `npm run db:migrate`.
# The local development database from `npm run db:local` uses these URLs:
# DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# Generate a random secret (at least 32 characters) for private classroom invites.
# Keep this value stable: changing it invalidates existing invitations.
CLASSROOM_INVITE_SECRET=""

# Optional public HTTPS origin used in WhatsApp classroom invitations.
# Set this when the teacher opens the app through localhost or an internal address.
# Otherwise invitations use the public HTTPS origin of the current app request.
# Example: CLASSROOM_PUBLIC_URL="https://teacher.example.com"
CLASSROOM_PUBLIC_URL=""

# Optional ICE servers for live video across different networks, JSON array.
# Supply TURN credentials for networks where direct connections are blocked.
# CLASSROOM_ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"}]'
