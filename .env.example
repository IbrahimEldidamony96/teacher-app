# Local development: copy to .env and fill with credentials from your
# Neon DEVELOPMENT branch. NEVER paste database passwords into GitHub.
# Runtime uses Neon's pooled host (contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-DEV-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Prisma CLI uses the matching direct host (NO "-pooler") for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-DEV.REGION.aws.neon.tech/neondb?sslmode=require"

# Optional separate EMPTY/disposable Neon branch for 'prisma migrate dev'.
# Do not point this to Production or the same branch as DIRECT_URL.
# SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@ep-SHADOW.REGION.aws.neon.tech/neondb?sslmode=require"

# Generate a random secret (>=32 chars). Changing it revokes old invitations.
CLASSROOM_INVITE_SECRET=vcsP98ChLyEZxVjDQ9-ly_ewfaNpjfVV1sTx6KGh3l4FZMupscBo-U7RrTO2An9M

# Set on Vercel to your actual public HTTPS URL.
# CLASSROOM_PUBLIC_URL="https://your-teacher-app.vercel.app"

# Optional TURN/STUN servers for reliable live classroom connectivity.
# CLASSROOM_ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"}]'
# Copy this file to ".env.local" and fill in your own values.
# Clerk-only development config. Keep BOTH Neon URLs in .env so Prisma CLI sees DIRECT_URL.

# Clerk (dashboard.clerk.com -> your app -> API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# The email you will sign up with. That account becomes the tutor (TEACHER) account;
# students must be approved on their student profile by their verified email.
# unapproved Clerk sign-ups cannot access student records.
TEACHER_EMAIL=teach@example.com

# Optional browser e2e tests: existing verified Clerk development student accounts
E2E_STUDENT_EMAIL_1=student1@example.com
E2E_STUDENT_EMAIL_2=student2@example.com

# WhatsApp Cloud API (optional - leave blank and notifications are skipped safely).
# Check the current Graph API version in your Meta App Dashboard.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=
# Needed by npm run whatsapp:setup to check/create the classroom template.
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Approve the Arabic WhatsApp template "classroom_invitation" before inviting a group.
# Body parameters, in order: student name, group name, lesson title, private invitation URL.

# Public HTTPS origin for student invitations when the teacher uses localhost.
# npm run public:start fills this automatically for the temporary local preview.
CLASSROOM_PUBLIC_URL=
